{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:charge_type",
          "cases": [
            {
              "when": "arrow",
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow_arrow_gui"
              }
            },
            {
              "when": "rocket",
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow_firework_gui"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_gui"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_arrow",
            "tints": [
              {
                "type": "bow3d:arrow_tint"
              }
            ]
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_firework"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_false": {
          "type": "minecraft:model",
          "model": "minecraft:item/crossbow"
        },
        "on_true": {
          "type": "minecraft:condition",
          "property": "bow3d:loading_firework",
          "on_true": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:crossbow/pull",
            "entries": [
              {
                "threshold": 0.33,
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_firework_pulling_1"
                }
              },
              {
                "threshold": 0.67,
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_firework_pulling_2"
                }
              },
              {
                "threshold": 1.0,
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_firework"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_firework_pulling_0"
            }
          },
          "on_false": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:crossbow/pull",
            "entries": [
              {
                "threshold": 0.33,
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_1",
                  "tints": [
                    {
                      "type": "bow3d:arrow_tint"
                    }
                  ]
                }
              },
              {
                "threshold": 0.67,
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_2",
                  "tints": [
                    {
                      "type": "bow3d:arrow_tint"
                    }
                  ]
                }
              },
              {
                "threshold": 1.0,
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_arrow",
                  "tints": [
                    {
                      "type": "bow3d:arrow_tint"
                    }
                  ]
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_pulling_0",
              "tints": [
                {
                  "type": "bow3d:arrow_tint"
                }
              ]
            }
          }
        }
      }
    }
  }
}
